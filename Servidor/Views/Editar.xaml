<Window x:Class="Servidor.Views.Editar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Servidor.Views" 
        xmlns:viewmodels="clr-namespace:Servidor.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ServerViewModel}"
        mc:Ignorable="d"
         Title="Editar" Height="390" Width="600" Background="#EBF2FA">
    <StackPanel Margin="20">

        <WrapPanel>
            <Image Source="/Images/cliente-servidor.png" Width="70" Height="60" Margin="40,5,0,5" Grid.Column="0" HorizontalAlignment="Right"/>
            <Label FontFamily="Bold" HorizontalAlignment="Center" Foreground="#064789 " Margin="15" FontSize="25"  Grid.Column="1">Servidor - Control de Laboratorios</Label>
        </WrapPanel>

        <Border BorderBrush="#427aa1" BorderThickness="3" CornerRadius="10" Margin="10" Background="White" >
            <StackPanel>
                <Label FontFamily="Bold" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#064789" Margin="10,5" FontSize="18">Escriba los nuevos datos para la computadora</Label>

                <Border Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1" Margin="0,3" BorderThickness="1" Padding="5"  Width="250">
                    <TextBox TextAlignment="Center" VerticalAlignment="Center" Foreground="#064789" Text="{Binding Clon.Nombre, Mode=TwoWay}" MaxLength="20" FontSize="22"></TextBox>
                </Border>
                
                <Border Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1" Margin="0,3" BorderThickness="1" Padding="5"  Width="250">
                    <ComboBox ItemsSource="{Binding Laboratorios}" SelectedItem="{Binding Clon.Laboratorio, Mode=TwoWay}" FontSize="20" Background="#EBF2FA" BorderBrush="#EBF2FA" Foreground="#064789"></ComboBox>
                </Border>
                
                <TextBlock TextAlignment="Center" VerticalAlignment="Center" Foreground="#064789" Text="{Binding Error}" FontSize="18" ></TextBlock>

                
                <WrapPanel  Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Padding="5" Margin="5" HorizontalAlignment="Right" Background="#679436" Foreground="#F0F0DB" Width="100" FontSize="18" FontFamily="bold" Command="{Binding EditarCommand}" CommandParameter="{Binding Clon}">Editar</Button>
                    <Button Padding="5" Margin="5" HorizontalAlignment="Left" Background="#30364F" Foreground="#F0F0DB" Width="100"  FontSize="18" FontFamily="bold" Command="{Binding RechazarCommand}">Cancelar</Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
