<Window x:Class="Servidor.Views.NotificacionRegistro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Servidor.Views" xmlns:viewmodels="clr-namespace:Servidor.ViewModels"
        mc:Ignorable="d" x:Name="VentanaRegistro"
        Title="NotificacionRegistro" Height="230" Width="370" Background="#EBF2FA">
    <Border Padding="20" BorderThickness="3" BorderBrush="#427AA1" Margin="10" CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontFamily="Bold" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#064789" FontSize="15">Nueva Solicitud de Registro</TextBlock>
            
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBox HorizontalAlignment="Center" Text="{Binding ComputadoraSeleccionada.Nombre, Mode=TwoWay}" Width="110" TextAlignment="Center"></TextBox>
                <TextBlock HorizontalAlignment="Center" Text="{Binding ComputadoraSeleccionada.Ip}"></TextBlock>
                <TextBlock HorizontalAlignment="Center" Text="{Binding ComputadoraSeleccionada.Puerto}"></TextBlock>
                <ComboBox HorizontalAlignment="Center"  ItemsSource="{Binding Laboratorios}" SelectedItem="{Binding ComputadoraSeleccionada.Laboratorio}" Width="110" FontSize="14" Background="#EBF2FA" BorderBrush="#EBF2FA" Foreground="#064789"></ComboBox>
                <TextBlock HorizontalAlignment="Center" Text="{Binding ComputadoraSeleccionada.MAC}"></TextBlock>
            </StackPanel>


            <WrapPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Margin="0,5" Width="100" FontFamily="Bold" Foreground="White" Background="#679436" HorizontalAlignment="Left"  Command="{Binding RegistrarCommand}" CommandParameter="{Binding ComputadoraSeleccionada}">Registrar</Button>
                <Button Margin="0,5" Width="100" FontFamily="Bold" Foreground="White" Background="#C00707" HorizontalAlignment="Right" Command="{Binding RechazarCommand}">Rechazar</Button>
            </WrapPanel>

        </Grid>
    </Border>
</Window>


