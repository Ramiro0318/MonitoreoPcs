                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" ></ColumnDefinition>
                                        <ColumnDefinition Width="250" ></ColumnDefinition>
                                        <ColumnDefinition Width="100"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>



                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Identificador}" ></TextBlock>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding HoraConexion }" Grid.Column="1"></TextBlock>
                                    <TextBlock HorizontalAlignment="Left" Grid.Column="2"> apagado</TextBlock>
                                   

                                   

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

        </Border>-->






        <Border Padding="10" Grid.Row="4"  BorderThickness="3" BorderBrush="#427AA1"  Margin="9" CornerRadius="10" Background="White">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>

                        <ColumnDefinition Width="auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Image  Source="/Images/computadora-portatil.png" Width="50" Height="50" Margin="120,5,0,5" Grid.Column="0" HorizontalAlignment="Left"/>
                    <Label FontFamily="Bold" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#064789" Margin="15"  FontSize="20" >Lista de historial de comandos</Label>
                    <Button Grid.Row="0" HorizontalAlignment="Right" BorderBrush="White" Background="White" Command="{Binding LimpiarCommand}" CommandParameter="conexiones">
                        <Image Source="/Images/delete.png" Width="30" Height="36"/>
                    </Button>
                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" ></ColumnDefinition>
                        <ColumnDefinition Width="100" ></ColumnDefinition>
                        <ColumnDefinition Width="200"></ColumnDefinition>
                        <ColumnDefinition Width="150"></ColumnDefinition>

                    </Grid.ColumnDefinitions>

                    <Label FontFamily="Britannic " HorizontalAlignment="Left"  Foreground="#064789"  FontWeight="SemiBold" FontSize="15" >ID Computadora</Label>
                    <Label  Grid.Column="1"  FontFamily="Britannic" HorizontalAlignment="Left"  Foreground="#064789"  FontWeight="SemiBold" FontSize="15">Comando</Label>
                    <Label Grid.Column="2" FontFamily="Britannic " HorizontalAlignment="Left"   Foreground="#064789"  FontWeight="SemiBold" FontSize="15">Nuevo nombre</Label>
                    <Label Grid.Column="3" FontFamily="Britannic" HorizontalAlignment="Left"   Foreground="#064789"  FontWeight="SemiBold" FontSize="15">Fecha</Label>


                </Grid>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding HistorialComandos}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" ></ColumnDefinition>
                                        <ColumnDefinition Width="100" ></ColumnDefinition>
                                        <ColumnDefinition Width="200"></ColumnDefinition>
                                        <ColumnDefinition Width="150"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>



                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Destino}" ></TextBlock>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Comando }" Grid.Column="1"></TextBlock>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding NuevoNombre }" Grid.Column="2"></TextBlock>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Fecha }" Grid.Column="3"></TextBlock>




                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

        </Border>

        <!--<StackPanel Grid.Row="6">

            <TextBox Text="{Binding Clon.Nombre}"></TextBox>

            <Button Command="{Binding EditarCommand}" CommandParameter="{Binding Clon}">Editar</Button>
            <Button Command="{Binding RechazarCommand}">Cancelar</Button>
        </StackPanel>-->








    </Grid>
</Window>
