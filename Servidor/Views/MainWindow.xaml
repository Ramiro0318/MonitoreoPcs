                        <ColumnDefinition Width="250" ></ColumnDefinition>
                        <ColumnDefinition Width="250" ></ColumnDefinition>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="59*"/>
                        <ColumnDefinition Width="11*"/>

                    </Grid.ColumnDefinitions>


                    <Label FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Left"  FontSize="15" >ID Computadora</Label>
                    <Label  Grid.Column="1"  FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Left"  FontSize="15" >Fecha</Label>
                    <Label Grid.Column="2" FontFamily="Bold" Foreground="#064789" FontWeight="SemiBold" HorizontalAlignment="Left"  FontSize="15" >Comando</Label>



                </Grid>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding HistorialConexiones}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
