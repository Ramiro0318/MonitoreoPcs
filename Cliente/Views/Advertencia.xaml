<UserControl x:Class="Cliente.Views.Advertencia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.Views"
        xmlns:viewmodel="clr-namespace:Cliente.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodel:ClienteViewModel}"
             mc:Ignorable="d"
        Background="#EBF2FA">
    
    <Border BorderThickness="3" BorderBrush="#427AA1" Margin="15" CornerRadius="10" Background="White">
        <StackPanel Background="White">

            <WrapPanel>
                <Image Source="/Images/megafono.png" Width="50" Height="40"  Margin="70,0,5,5" HorizontalAlignment="Right"/>
                <Label FontFamily="Bold" HorizontalAlignment="Left" Foreground="#064789 " FontWeight="SemiBold" Margin="0" FontSize="25">¡Atención!</Label>
            </WrapPanel>

            <StackPanel Margin="10">
                <TextBlock FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" Width="240" FontSize="15">
                    <Run Text="Esta computadora se va a " />
                    <Run Text="{Binding Accion}" FontWeight="SemiBold" />
                    <Run Text=" en un momento." />
                </TextBlock>
                <TextBlock Text="{Binding Segundos}" FontFamily="Bold" FontWeight="Bold" Margin="0,8,0,0" Foreground="#064789" HorizontalAlignment="Center" FontSize="30"></TextBlock>

                <WrapPanel Margin="5" >
                    <Image Source="/Images/crisis.png" Width="40" Height="40" HorizontalAlignment="Right"/>
                    <TextBlock FontFamily="Bold" FontWeight="SemiBold"  Foreground="#064789 " HorizontalAlignment="Center" Margin="10" FontSize="15"> Guarde su trabajo o cancele la tarea.</TextBlock>
                    <Image Source="/Images/crisis.png" Width="40" Height="40" HorizontalAlignment="Left"/>
                </WrapPanel>
                <Button Width="200" FontSize="15" Command="{Binding CancelarComandoCommand}">CANCELAR</Button>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
