<Window x:Class="Cliente.Views.Advertencia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.Views"
        mc:Ignorable="d"
        Title="Advertencia" Height="250" Width="400">
    <Grid Margin="10" Background="#E1D9BC" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
            <RowDefinition Height="auto"  ></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="25"> Atencion!</TextBlock>

        </Grid>
        <Grid Grid.Row="1" Margin="25">
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="15">Esta computadora va a APAGARSE en un momento</TextBlock>

        </Grid>

        <Grid Grid.Row="2" Margin="5" >

            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="15"> Apagado Proximo </TextBlock>



        </Grid>


        <Grid Grid.Row="3" Margin="15" >

            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="15"> Guarde todo su trabajo antes de que   </TextBlock>

        </Grid>
        <Grid Grid.Row="4"  >

            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="15"> la computadora se apague.</TextBlock>

        </Grid>

    </Grid>
</Window>
