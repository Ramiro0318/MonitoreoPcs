<Window x:Class="Cliente.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente"
        xmlns:viewmodel="clr-namespace:Cliente.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodel:ClienteViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodel:ClienteViewModel></viewmodel:ClienteViewModel>
    </Window.DataContext>
    <StackPanel>
        <TextBox Text="{Binding IpPorValidar}"></TextBox>
        <TextBox Text="{Binding Nombre}"></TextBox>
        <Button Command="{Binding EnviarRegistroCommand}">Enviar registro</Button>

        <Label Content="{Binding Info}" FontSize="30"></Label>
        
    </StackPanel>
</Window>
