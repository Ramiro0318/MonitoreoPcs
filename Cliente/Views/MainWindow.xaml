<Window x:Class="Cliente.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.ViewModels"
        xmlns:viewmodel="clr-namespace:Cliente.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodel:ClienteViewModel}"
        mc:Ignorable="d"
        Title="Cliente" Height="250" Width="400">
    <Window.DataContext>
        <viewmodel:ClienteViewModel></viewmodel:ClienteViewModel>
    </Window.DataContext>

    <Grid Margin="10" Background="#E1D9BC" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
            <RowDefinition Height="auto"  ></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="25">Cliente de laboratorio</TextBlock>
            
        </Grid>
        <Grid Grid.Row="1" Margin="5">
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Left"  FontSize="15">Configuracion:</TextBlock>

        </Grid>

        <Grid Grid.Row="2" Margin="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Right"  FontSize="10">Direccion IP del servidor:</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding IpPorValidar}"></TextBox>
        </Grid>


        <Grid Grid.Row="3" Margin="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Right"  FontSize="10">Nombre del equipo:</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding Nombre}"></TextBox>
        </Grid>


        <Grid Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <Button Grid.Column="1" Padding="6,0,6,0" FontFamily="Britannic Bold" HorizontalAlignment="Center"  Background="#30364F" Foreground="#F0F0DB" Command="{Binding EnviarRegistroCommand}">Enviar</Button>
        </Grid>

        <Grid Grid.Row="5">
            <TextBlock Text="{Binding Info}" HorizontalAlignment="Center" FontSize="30"></TextBlock>
        </Grid>
        
        

    </Grid>


</Window>
