<UserControl x:Class="Cliente.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cliente.Views" xmlns:viewmodels="clr-namespace:Cliente.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ClienteViewModel}"
             mc:Ignorable="d">

    <Border BorderThickness="3" BorderBrush="#427AA1" Margin="20" CornerRadius="10" Background="White">
        <Grid Margin="10" Background="White" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="20"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Center" FontSize="23">Cliente de laboratorio</TextBlock>
            <Label Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Left">Configurancion:</Label>

            <Label Grid.Row="2" Grid.Column="0" Margin="5" HorizontalAlignment="Right">Nombre del equipo:</Label>
            <Border Grid.Row="2" Grid.Column="1" Margin="5" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5">
                <TextBox  TextAlignment="Center" Background="#EBF2FA" BorderBrush="#EBF2FA" Foreground="#064789" Text="{Binding Nombre}" MaxLength="20"></TextBox>
            </Border>

            <Label  Grid.Row="3" Grid.Column="0" Margin="5" HorizontalAlignment="Right">Direccion IP del servidor:</Label>
            <Border  Grid.Row="3" Grid.Column="1" Margin="5" Background="#F0F8FF" CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5">
                <TextBox  TextAlignment="Center" Background="#EBF2FA" BorderBrush="#EBF2FA"  Foreground="#064789" Text="{Binding IpPorValidar}" ></TextBox>
            </Border>

            <Label Grid.Row="4" Grid.Column="0" Margin="5" HorizontalAlignment="Right">Laboratorio:</Label>
            <Border Grid.Row="4"  Grid.Column="1" Margin="5" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1" BorderThickness="1" Padding="5">
                <ComboBox ItemsSource="{Binding Laboratorios}" SelectedItem="{Binding Laboratorio}" FontSize="18" Background="#EBF2FA" BorderBrush="#EBF2FA" Foreground="#064789"></ComboBox>
            </Border>

            <Button Grid.Row="5" Grid.Column="1" Padding="6,0,6,0" Margin="6" FontFamily="Bold" FontSize="18"  HorizontalAlignment="Center" Width="100"  Background="#679436" Foreground="#F0F0DB"   Command="{Binding EnviarRegistroCommand}">Enviar</Button>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding Info}" HorizontalAlignment="Center" Foreground="#064789"  FontSize="15"></TextBlock>

        </Grid>
    </Border>
</UserControl>
