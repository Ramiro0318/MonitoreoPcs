<Window x:Class="Cliente.Views.Conectado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.Views"
        mc:Ignorable="d"
        Title="Conectado" Height="250" Width="400">
    <Grid Margin="10" Background="#E1D9BC" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto" ></RowDefinition>
            <RowDefinition Height="auto"  ></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Center"  FontSize="25">Cliente de laboratorio</TextBlock>

        </Grid>
        <Grid Grid.Row="1" Margin="5">
            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Left"  FontSize="15">Informacion:</TextBlock>

        </Grid>

        <Grid Grid.Row="2" Margin="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Right"  FontSize="10">ID Asignado:</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding Registro.NombreAsignado}"></TextBox>
        </Grid>


        <Grid Grid.Row="3" Margin="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Right"  FontSize="10">IP:</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding Registro.Ip}"></TextBox>
        </Grid>



        <Grid Grid.Row="4" Margin="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock  FontFamily="Britannic Bold" HorizontalAlignment="Right"  FontSize="10">Puerto:</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding Registro.Puerto}"></TextBox>
        </Grid>


        <Grid Grid.Row="5">
            <TextBlock Text="{Binding Info}" HorizontalAlignment="Center" FontSize="30"></TextBlock>
        </Grid>



    </Grid>
</Window>
