<Window x:Class="Cliente.Views.Conectado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.Views"
        mc:Ignorable="d"
      Title="Conectado" Height="300" Width="400" MaxHeight="300" MaxWidth="400" Background="#EBF2FA">
    
    <Border BorderThickness="3" BorderBrush="#427AA1" Margin="20" CornerRadius="10" Background="White">
        <Grid Margin="10" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto" ></RowDefinition>
                <RowDefinition Height="auto"  ></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Image Source="/Images/usuario-de-computadora-portatil.png" Width="40" Height="40" Margin="0,0,10,0"></Image>

                   <TextBlock  FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23">Cliente de laboratorio</TextBlock>

                </StackPanel>

               

            </Grid>
            <Grid Grid.Row="1" Margin="5">
                <TextBlock  FontFamily="Bold" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#064789"  FontSize="15">Informacioncion:</TextBlock>

            </Grid>

            <Grid Grid.Row="2" Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>



                <TextBlock  FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">ID Asignado:</TextBlock>

                <Border Grid.Column="1" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">

                    <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.NombreAsignado}" ></TextBlock>
                </Border>

            </Grid>


            <Grid Grid.Row="3" Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>



                <TextBlock  FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">IP:</TextBlock>

                <Border Grid.Column="1" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">

                    <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.Ip}" ></TextBlock>
                </Border>
              
            </Grid>



            <Grid Grid.Row="4" Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>



                <TextBlock  FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">Puerto:</TextBlock>


                <Border Grid.Column="1" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">

                    <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.Puerto}" ></TextBlock>
                </Border>
            </Grid>


            <Grid Grid.Row="5">
                <TextBlock Text="{Binding Info}" HorizontalAlignment="Center" Foreground="#064789"  FontSize="15"></TextBlock>
            </Grid>



        </Grid>
    </Border>


</Window>

