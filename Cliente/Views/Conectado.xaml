<UserControl x:Class="Cliente.Views.Conectado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cliente.Views" xmlns:viewmodels="clr-namespace:Cliente.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ClienteViewModel}"
        mc:Ignorable="d" Background="#EBF2FA">

    <Border BorderThickness="3" BorderBrush="#427AA1" Margin="18" CornerRadius="10" Background="White">
        <Grid Margin="10" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto" ></RowDefinition>
                <RowDefinition Height="auto"  ></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Images/usuario-de-computadora-portatil.png" Width="40" Height="40" Margin="0,0,10,0"></Image>
                <TextBlock FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23">Cliente de laboratorio</TextBlock>
            </WrapPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" FontFamily="Bold" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#064789" FontSize="15">Informacioncion:</TextBlock>

            <TextBlock Grid.Row="2" Margin="5" FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">ID Asignado:</TextBlock>
            <Border Grid.Row="2" Margin="5" Grid.Column="1" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">
                <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.NombreAsignado}" ></TextBlock>
            </Border>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">IP:</TextBlock>
            <Border Grid.Row="3" Grid.Column="1" Margin="5" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">
                <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.IpServidor}" ></TextBlock>
            </Border>


            <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">Puerto:</TextBlock>
            <Border Grid.Row="4" Grid.Column="1" Margin="5" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">
                <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.PuertoServidor}" ></TextBlock>
            </Border>


            <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="Bold" FontWeight="SemiBold" Foreground="#064789" HorizontalAlignment="Right" Padding="6" FontSize="10">Laboratorio:</TextBlock>
            <Border Grid.Row="5" Grid.Column="1" Background="#F0F8FF " CornerRadius="8" BorderBrush="#427AA1 " BorderThickness="1" Padding="5"  Width="150">
                <TextBlock  TextAlignment="Center"  Foreground="#064789" Text="{Binding Registro.Laboratorio}" ></TextBlock>
            </Border>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding Info}" HorizontalAlignment="Center" Foreground="#064789" FontSize="15"></TextBlock>
        </Grid>
    </Border>
</UserControl>

